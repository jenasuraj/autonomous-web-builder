{
  "name": "web-builder",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run start:dev -w backend\" \"npm run dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run start:dev -w backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "npm run test:e2e -w backend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
