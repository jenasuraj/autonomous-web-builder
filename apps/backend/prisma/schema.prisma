// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  threads  Thread[]

  @@map("users")
}

model Thread {
  id        Int      @id @default(autoincrement())
  threadId  String   @unique // `${userId}-${randomUUID()}`, also the LangGraph thread_id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?  // null until the first message; also marks an unused "new chat"
  history   Json     @default("[]") // [{ role: 'user' | 'assistant', content }]
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt]) // "my chats, newest first"
  @@map("threads")
}