# Pooled connection: used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full"

# Direct (non-pooled) connection: used by Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full"

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Redis (docker compose up -d)
REDIS_URL="redis://localhost:6379"

# Email (Gmail SMTP). Leave empty in dev to log OTPs to the console instead
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# LLM: Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
